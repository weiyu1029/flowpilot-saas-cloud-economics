{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawAndWriteCurated",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET/raw/*",
        "arn:aws:s3:::REPLACE_BUCKET/curated/*"
      ]
    },
    {
      "Sid": "ListProjectBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/*",
            "curated/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteFunctionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}