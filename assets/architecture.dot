digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.75, fontname="Arial"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#CBD5E1", penwidth=1.2, margin="0.18,0.12"];
  edge [color="#64748B", penwidth=1.3, arrowsize=0.8];
  synthetic [label="Synthetic SaaS Data\nCustomers · Usage · Revenue · Cost", fillcolor="#E0F2FE", color="#0284C7"];
  s3raw [label="Amazon S3\nraw / processed / curated", fillcolor="#DCFCE7", color="#16A34A"];
  lambda [label="AWS Lambda / Glue\nValidation · ETL · KPI logic", fillcolor="#FEF3C7", color="#D97706"];
  catalog [label="Glue Data Catalog", fillcolor="#F3E8FF", color="#7C3AED"];
  athena [label="Amazon Athena\nServerless SQL", fillcolor="#E0E7FF", color="#4F46E5"];
  app [label="Streamlit Dashboard\n7 stakeholder views", fillcolor="#DBEAFE", color="#2563EB"];
  ops [label="CloudWatch · SNS · Budgets\nMonitoring & cost controls", fillcolor="#FEE2E2", color="#DC2626"];
  rag [label="Optional Insights Copilot\nClaude · OpenAI · Bedrock", fillcolor="#CCFBF1", color="#0F766E"];
  users [label="Product · Finance · CS · Engineering", shape=oval, fillcolor="#F8FAFC", color="#64748B"];
  synthetic -> s3raw -> lambda -> catalog -> athena -> app -> users;
  lambda -> ops; athena -> ops; app -> rag; rag -> users;
}